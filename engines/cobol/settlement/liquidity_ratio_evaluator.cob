       2100-EXECUTE-BLOCK-01 SECTION.
       2100-B01.
           COMPUTE WS-INTERMEDIATE-TERM = WS-B01-NOTIONAL * WS-B01-INTEREST-RATE.
           COMPUTE WS-B01-MARGIN-REQ = WS-INTERMEDIATE-TERM + (WS-B01-SPREAD-BPS * 0.01).
           ADD WS-B01-MARGIN-REQ TO WS-TOTAL-DEBITS.
           ADD WS-B01-NOTIONAL TO WS-TOTAL-CREDITS.
           ADD 1 TO WS-RECORDS-PROCESSED.
           IF WS-B01-MARGIN-REQ > 0
               MOVE 'OK' TO WS-B01-RESULT-CODE
           ELSE
               MOVE 'ER' TO WS-B01-RESULT-CODE
           END-IF.
      *> Domain Audit: Block 01 verification for LIQUIDITY-RATIO-EVALUATOR
           COMPUTE WS-ACCUMULATED-TOTAL = WS-ACCUMULATED-TOTAL + WS-INTERMEDIATE-TERM.
           COMPUTE WS-NET-VARIANCE = WS-TOTAL-CREDITS - WS-TOTAL-DEBITS.
           IF WS-NET-VARIANCE < 0
               MOVE 1 TO WS-RETURN-CODE
           END-IF.
           EXIT.
       2100-EXECUTE-BLOCK-02 SECTION.
       2100-B02.
           COMPUTE WS-INTERMEDIATE-TERM = WS-B02-NOTIONAL * WS-B02-INTEREST-RATE.
           COMPUTE WS-B02-MARGIN-REQ = WS-INTERMEDIATE-TERM + (WS-B02-SPREAD-BPS * 0.01).
           ADD WS-B02-MARGIN-REQ TO WS-TOTAL-DEBITS.
           ADD WS-B02-NOTIONAL TO WS-TOTAL-CREDITS.
           ADD 1 TO WS-RECORDS-PROCESSED.
           IF WS-B02-MARGIN-REQ > 0
               MOVE 'OK' TO WS-B02-RESULT-CODE
           ELSE
               MOVE 'ER' TO WS-B02-RESULT-CODE
