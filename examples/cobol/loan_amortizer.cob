       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOAN-AMORTIZER-DEMO.
       AUTHOR. GHOSTCODE-DEMO.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-LOAN-PARAMS.
          05 WS-PRINCIPAL            PIC 9(9)V99 VALUE 250000.00.
          05 WS-ANNUAL-RATE          PIC 9V9999 VALUE 0.0525.
          05 WS-MONTHS               PIC 9(3) VALUE 360.
          05 WS-MONTHLY-RATE         PIC 9V999999 VALUE 0.00.
          05 WS-MONTHLY-PAYMENT      PIC 9(7)V99 VALUE 0.00.
          05 WS-TOTAL-PAYMENT        PIC 9(9)V99 VALUE 0.00.
          05 WS-TOTAL-INTEREST       PIC 9(9)V99 VALUE 0.00.

       PROCEDURE DIVISION.
       0000-RUN-AMORTIZATION.
           DISPLAY "=== GHOSTCODE LOAN AMORTIZATION DEMO ==="
           COMPUTE WS-MONTHLY-RATE = WS-ANNUAL-RATE / 12
           COMPUTE WS-MONTHLY-PAYMENT ROUNDED = 
               WS-PRINCIPAL * (WS-MONTHLY-RATE / (1 - (1 + WS-MONTHLY-RATE) ** (-360)))
           COMPUTE WS-TOTAL-PAYMENT = WS-MONTHLY-PAYMENT * WS-MONTHS
           COMPUTE WS-TOTAL-INTEREST = WS-TOTAL-PAYMENT - WS-PRINCIPAL
           DISPLAY "PRINCIPAL:        " WS-PRINCIPAL
           DISPLAY "MONTHLY PAYMENT:  " WS-MONTHLY-PAYMENT
           DISPLAY "TOTAL INTEREST:   " WS-TOTAL-INTEREST
           DISPLAY "=== LOAN AMORTIZATION COMPLETED ==="
           STOP RUN.
